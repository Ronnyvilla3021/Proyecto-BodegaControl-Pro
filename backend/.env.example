# ============================================
# Bodega Control Pro - Variables de entorno
# ============================================
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
# ============================================

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bodega_control_pro?schema=public"

# --- Autenticación JWT ---
# Genera uno seguro con: openssl rand -base64 32
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_random"
# Duración del token (ej: 8h, 1d, 7d)
JWT_EXPIRES_IN="8h"

# --- Servidor ---
PORT=3000

# --- Email (opcional - notificaciones) ---
# Para Gmail usa una "App Password", no tu contraseña normal
# https://myaccount.google.com/apppasswords
EMAIL_USER=""
EMAIL_PASSWORD=""
